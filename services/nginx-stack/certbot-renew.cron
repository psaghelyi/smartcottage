# Let's Encrypt renewal for psaghelyi.ddns.net (run twice daily).
# Install: sudo cp certbot-renew.cron /etc/cron.d/ && sudo chmod 644 /etc/cron.d/certbot-renew.cron
# Edit the path below if your repo lives elsewhere.
SHELL=/bin/bash
PATH=/usr/bin:/bin

0 3,15 * * * root /mnt/sda1/Project/github/psaghelyi/smartcottage/services/nginx-stack/renewcert.sh >> /var/log/certbot-renew.log 2>&1
